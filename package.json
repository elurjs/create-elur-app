{
  "name": "create-elur-app",
  "version": "2.2.1",
  "description": "Scaffolding tool for Elur reactive framework",
  "type": "module",
  "bin": {
    "create-elur-app": "dist/index.js"
  },
  "files": [
    "dist",
    "template-elur-ionic",
    "template-elur-ionic-tabs",
    "template-kit",
    "template-vanilla-js",
    "template-vanilla-ts",
    "template-vite-js",
    "template-vite-ts"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "ELUR_E2E=1 vitest run test/e2e.test.ts",
    "sync:deps": "node scripts/sync-deps.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "elur",
    "framework",
    "reactive",
    "cli",
    "create-app",
    "scaffolding"
  ],
  "author": "Deiver Vasquez",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.8.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "tsup": "^8.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
